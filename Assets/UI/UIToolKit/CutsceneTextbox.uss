.cutscene-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cutscene-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.cutscene-textbox {
    position: absolute;
    left: 48px;
    right: 48px;
    bottom: 28px;
    min-height: 180px;
    flex-direction: row;
    align-items: center;
    padding: 14px 56px 14px 18px;
    background-color: rgba(20, 18, 28, 0.9);
    border-width: 2px;
    border-color: rgb(235, 230, 210);
    border-radius: 6px;
}

.cutscene-portrait {
    width: 152px;
    height: 152px;
    flex-shrink: 0;
    margin-right: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

.cutscene-text-column {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
}

.cutscene-speaker {
    margin-bottom: 6px;
    color: rgb(235, 230, 210);
    font-size: 28px;
    -unity-text-align: upper-left;
    -unity-font-definition: url("project://database/Assets/Art/UI/Font/m6x11plus.ttf?fileID=12800000&guid=5c4849afec005f14bb5956122a7bc595&type=3#m6x11plus");
}

.cutscene-text {
    color: rgb(245, 240, 225);
    font-size: 26px;
    white-space: normal;
    -unity-text-align: upper-left;
    -unity-font-definition: url("project://database/Assets/Art/UI/Font/m6x11plus.ttf?fileID=12800000&guid=5c4849afec005f14bb5956122a7bc595&type=3#m6x11plus");
}

.cutscene-advance {
    position: absolute;
    right: 14px;
    bottom: 10px;
    align-items: flex-end;
}

.cutscene-advance-icon {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

.cutscene-hint {
    color: rgb(180, 175, 160);
    font-size: 18px;
    -unity-font-definition: url("project://database/Assets/Art/UI/Font/m6x11plus.ttf?fileID=12800000&guid=5c4849afec005f14bb5956122a7bc595&type=3#m6x11plus");
}
