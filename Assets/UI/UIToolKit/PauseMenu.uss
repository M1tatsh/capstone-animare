.pause-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.pause-panel {
    min-width: 360px;
    padding: 18px 28px 22px 28px;
    background-color: rgba(20, 18, 28, 0.95);
    border-width: 2px;
    border-color: rgb(235, 230, 210);
    border-radius: 8px;
    align-items: stretch;
}

.pause-title {
    color: rgb(245, 240, 225);
    font-size: 40px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    -unity-font-definition: url("project://database/Assets/Art/UI/Font/m6x11plus.ttf?fileID=12800000&guid=5c4849afec005f14bb5956122a7bc595&type=3#m6x11plus");
}

.pause-button {
    height: 40px;
    margin: 4px 0 4px 0;
    font-size: 24px;
    color: rgb(245, 240, 225);
    background-color: rgba(60, 54, 80, 0.9);
    border-width: 2px;
    border-color: rgba(235, 230, 210, 0.4);
    border-radius: 6px;
    -unity-font-definition: url("project://database/Assets/Art/UI/Font/m6x11plus.ttf?fileID=12800000&guid=5c4849afec005f14bb5956122a7bc595&type=3#m6x11plus");
}


.pause-button:hover,
.pause-button:focus {
    background-color: rgba(110, 90, 150, 1);
    border-color: rgb(235, 230, 210);
}

.pause-slider {
    margin: 8px 0 4px 0;
}

.pause-slider Label {
    color: rgb(245, 240, 225);
    font-size: 22px;
    min-width: 90px;
    -unity-font-definition: url("project://database/Assets/Art/UI/Font/m6x11plus.ttf?fileID=12800000&guid=5c4849afec005f14bb5956122a7bc595&type=3#m6x11plus");
}
