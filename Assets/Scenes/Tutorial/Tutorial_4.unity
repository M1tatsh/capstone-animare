  pages:
  - text: Rotating can pull the player to the closest platform to the camera.
    image: {fileID: 21300000, guid: c83e8b36e40c2ce41bd07e6499f4e9b4, type: 3}
    advanceWithAction: {fileID: -6130356163714354010, guid: 41cc5cdb547c27c48aac175026022067, type: 3}
    voiceSound: {fileID: 0}
  - text: The player will only get pulled when they begin to move after a rotation
      completes.
    image: {fileID: 21300000, guid: c83e8b36e40c2ce41bd07e6499f4e9b4, type: 3}
    advanceWithAction: {fileID: -6130356163714354010, guid: 41cc5cdb547c27c48aac175026022067, type: 3}
    voiceSound: {fileID: 0}
  textboxOffset: {x: 0, y: 1, z: 0}
  startDelay: 0.5
  tutorialName: Depth Pull Tutorial
  showEveryTime: 1
  pauseGameplayUntilFinished: 1
